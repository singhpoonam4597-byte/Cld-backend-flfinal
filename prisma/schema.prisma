// ============================================
// GROUP CHATS
// ============================================
model Group {
  id            String     @id @default(cuid())
  name          String
  description   String?
  image         String?
  createdBy     String     @db.Uuid
  creator       User       @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members       GroupMember[]
  messages      Message[]  @relation("GroupMessages")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdBy])
}

model GroupMember {
  id            String     @id @default(cuid())
  groupId       String     @db.Text
  group         Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String     @db.Uuid
  user          User       @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role          String     @default("member") // admin, moderator, member
  joinedAt      DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

// ============================================
// COMMUNITIES
// ============================================
model Community {
  id            String     @id @default(cuid())
  name          String     @unique
  description   String?
  image         String?
  createdBy     String     @db.Uuid
  creator       User       @relation("CommunityCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members       CommunityMember[]
  roles         CommunityRole[]
  channels      Channel[]
  posts         Post[]     @relation("CommunityPosts")
  inviteCode    String?    @unique @default(cuid())
  isPublic      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdBy])
}

model CommunityMember {
  id            String     @id @default(cuid())
  communityId   String     @db.Text
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId        String     @db.Uuid
  user          User       @relation("CommunityMemberships", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String?    @db.Text
  joinedAt      DateTime   @default(now())

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId])
}

model CommunityRole {
  id            String     @id @default(cuid())
  communityId   String     @db.Text
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name          String     // admin, moderator, member, viewer
  permissions   String[]   @default([])
  createdAt     DateTime   @default(now())

  @@unique([communityId, name])
  @@index([communityId])
}

model Channel {
  id            String     @id @default(cuid())
  name          String
  description   String?
  communityId   String     @db.Text
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  isPrivate     Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([communityId])
}

// ============================================
// MESSAGE ENHANCEMENTS
// ============================================
model Message {
  id            String     @id @default(cuid())
  content       String
  senderId      String     @db.Uuid
  sender        User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  // For 1:1 conversations
  conversationId String?    @db.Text
  
  // For group chats
  groupId       String?    @db.Text
  group         Group?     @relation("GroupMessages", fields: [groupId], references: [id], onDelete: Cascade)
  
  // For replies/threads
  replyToId     String?    @db.Text
  replyTo       Message?   @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies       Message[]  @relation("MessageReplies")
  
  // Message features
  reactions     Reaction[]
  isPinned      Boolean    @default(false)
  pinnedBy      String?    @db.Uuid
  pinnedAt      DateTime?
  
  // Editing
  isEdited      Boolean    @default(false)
  editedAt      DateTime?
  
  // Metadata
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([senderId])
  @@index([conversationId])
  @@index([groupId])
  @@index([replyToId])
}

model Reaction {
  id            String     @id @default(cuid())
  messageId     String     @db.Text
  message       Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId        String     @db.Uuid
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji         String     // 👍, ❤️, etc
  createdAt     DateTime   @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

