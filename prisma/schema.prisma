// This is the COMPLETE schema.prisma
// Replace your entire prisma/schema.prisma with this

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// USER MODEL
// ============================================
model User {
  id                      String     @id @default(cuid())
  email                   String     @unique
  username                String     @unique
  displayName             String?
  password                String
  avatar                  String?
  bio                     String?
  online                  Boolean    @default(false)
  lastSeen                DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  // Messages & Conversations
  messages                Message[]
  conversations           Conversation[] @relation("User1Conversations")
  conversations2          Conversation[] @relation("User2Conversations")

  // Groups
  groupMemberships        GroupMember[]
  createdGroups           Group[]    @relation("GroupCreator")

  // Communities
  communityMemberships    CommunityMember[]
  createdCommunities      Community[] @relation("CommunityCreator")

  // Posts & Social
  posts                   Post[]
  followers               Follow[]   @relation("FollowingUser")
  following               Follow[]   @relation("FollowerUser")

  // Reactions & Notifications
  reactions               Reaction[]
  notifications           Notification[]

  @@index([email])
  @@index([username])
}

// ============================================
// CONVERSATIONS (1:1 DMs)
// ============================================
model Conversation {
  id            String     @id @default(cuid())
  user1Id       String     @db.Uuid
  user1         User       @relation("User1Conversations", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id       String     @db.Uuid
  user2         User       @relation("User2Conversations", fields: [user2Id], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// ============================================
// GROUP CHATS
// ============================================
model Group {
  id            String     @id @default(cuid())
  name          String
  description   String?
  image         String?
  createdBy     String     @db.Uuid
  creator       User       @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members       GroupMember[]
  messages      Message[]  @relation("GroupMessages")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdBy])
}

model GroupMember {
  id            String     @id @default(cuid())
  groupId       String     @db.Text
  group         Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String     @db.Uuid
  user          User       @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role          String     @default("member") // admin, moderator, member
  joinedAt      DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

// ============================================
// COMMUNITIES
// ============================================
model Community {
  id            String     @id @default(cuid())
  name          String     @unique
  description   String?
  image         String?
  createdBy     String     @db.Uuid
  creator       User       @relation("CommunityCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members       CommunityMember[]
  roles         CommunityRole[]
  channels      Channel[]
  posts         Post[]     @relation("CommunityPosts")
  inviteCode    String?    @unique @default(cuid())
  isPublic      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdBy])
}

model CommunityMember {
  id            String     @id @default(cuid())
  communityId   String     @db.Text
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId        String     @db.Uuid
  user          User       @relation("CommunityMemberships", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String?    @db.Text
  joinedAt      DateTime   @default(now())

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId])
}

model CommunityRole {
  id            String     @id @default(cuid())
  communityId   String     @db.Text
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name          String     // admin, moderator, member, viewer
  permissions   String[]   @default([])
  createdAt     DateTime   @default(now())

  @@unique([communityId, name])
  @@index([communityId])
}

model Channel {
  id            String     @id @default(cuid())
  name          String
  description   String?
  communityId   String     @db.Text
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  isPrivate     Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([communityId])
}

// ============================================
// MESSAGES (Enhanced)
// ============================================
model Message {
  id            String     @id @default(cuid())
  content       String
  senderId      String     @db.Uuid
  sender        User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  // For 1:1 conversations
  conversationId String?    @db.Text
  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  // For group chats
  groupId       String?    @db.Text
  group         Group?     @relation("GroupMessages", fields: [groupId], references: [id], onDelete: Cascade)
  
  // For replies/threads
  replyToId     String?    @db.Text
  replyTo       Message?   @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies       Message[]  @relation("MessageReplies")
  
  // Message features
  reactions     Reaction[]
  isPinned      Boolean    @default(false)
  pinnedBy      String?    @db.Uuid
  pinnedAt      DateTime?
  
  // Editing
  isEdited      Boolean    @default(false)
  editedAt      DateTime?
  
  // Metadata
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([senderId])
  @@index([conversationId])
  @@index([groupId])
  @@index([replyToId])
}

model Reaction {
  id            String     @id @default(cuid())
  messageId     String     @db.Text
  message       Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId        String     @db.Uuid
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji         String     // 👍, ❤️, etc
  createdAt     DateTime   @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// ============================================
// POSTS (Social Feed)
// ============================================
model Post {
  id            String     @id @default(cuid())
  content       String
  authorId      String     @db.Uuid
  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityId   String?    @db.Text
  community     Community? @relation("CommunityPosts", fields: [communityId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([authorId])
  @@index([communityId])
}

// ============================================
// FOLLOW RELATIONSHIPS
// ============================================
model Follow {
  id            String     @id @default(cuid())
  followerId    String     @db.Uuid
  follower      User       @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  followingId   String     @db.Uuid
  following     User       @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================
// NOTIFICATIONS
// ============================================
model Notification {
  id            String     @id @default(cuid())
  userId        String     @db.Uuid
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String     // message, follow, reaction, etc
  title         String?
  content       String?
  read          Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([read])
}
