{
  "name": "social-app-backend",
  "version": "1.0.0",
  "description": "Instagram/WhatsApp-style social app backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "npx prisma db push --accept-data-loss && node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "lint": "eslint src/**/*.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "social",
    "instagram",
    "whatsapp",
    "fastify",
    "prisma"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.25.2",
    "@fastify/cors": "^8.4.2",
    "@fastify/jwt": "^7.1.1",
    "@fastify/multipart": "^8.0.0",
    "@prisma/client": "^5.7.1",
    "prisma": "^5.7.1",
    "cloudinary": "^1.40.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
